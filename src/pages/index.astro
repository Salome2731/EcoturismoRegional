---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Destinations from '../components/sections/Destinations.astro';
---

<BaseLayout>
  <Header />
  <main class="flex-1">
    <Hero />
    <Destinations />

    <section id="galeria" class="scroll-mt-20 py-16 text-center text-stone-600">
      <p>Espacio reservado para la galería interactiva (T21).</p>
    </section>
    <section id="rutas" class="scroll-mt-20 py-16 text-center text-stone-600">
      <p>Espacio reservado para el mapa de rutas (T24).</p>
    </section>
    <section id="contacto" class="scroll-mt-20 py-16 text-center text-stone-600">
      <p>Espacio reservado para el formulario de contacto (T28).</p>
    </section>
  </main>
  <Footer />
</BaseLayout>