---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Destinations from '../components/sections/Destinations.astro';
import Gallery from '../components/sections/Gallery.astro';
import GalleryModal from '../components/sections/GalleryModal.astro';
import RouteMap from '../components/sections/RouteMap.astro';
import ContactForm from '../components/sections/ContactForm.astro';
---

<BaseLayout>
  <Header />
  <main class="flex-1">
    <Hero />
    <Destinations />
    <Gallery />
    <RouteMap />
    <ContactForm />
  </main>
  <GalleryModal />
  <Footer />
</BaseLayout>