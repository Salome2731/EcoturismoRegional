---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Destinations from '../components/sections/Destinations.astro';
import Gallery from '../components/sections/Gallery.astro';
import GalleryModal from '../components/sections/GalleryModal.astro';
import RouteMap from '../components/sections/RouteMap.astro';
---

<BaseLayout>
  <Header />
  <main class="flex-1">
    <Hero />
    <Destinations />
    <Gallery />
    <RouteMap />

    <section id="contacto" class="scroll-mt-20 py-16 text-center text-stone-600">
      <p>Espacio reservado para el formulario de contacto (T28).</p>
    </section>
  </main>
  <GalleryModal />
  <Footer />
</BaseLayout>