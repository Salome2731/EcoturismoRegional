---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Destination } from '../../types';

interface Props {
  destination: Destination;
  imageMetadata: ImageMetadata;
}

const { destination, imageMetadata } = Astro.props;

const badgeClasses =
  destination.subregion === 'Occidente'
    ? 'bg-amber-100 text-amber-900 border-amber-300'
    : 'bg-emerald-100 text-emerald-900 border-emerald-300';

const accentClasses =
  destination.subregion === 'Occidente' ? 'border-t-amber-500' : 'border-t-emerald-600';

const shownActivities = destination.activities.slice(0, 3);
---

<article class={`flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 border-t-4 bg-white shadow-sm ${accentClasses}`}>
  <Image
    src={imageMetadata}
    alt={`Paisaje de ${destination.name}, Antioquia`}
    width={800}
    height={600}
    loading="lazy"
    class="aspect-[4/3] w-full object-cover"
  />

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-xl font-bold text-stone-900">{destination.name}</h3>
      <span class={`rounded-full border px-3 py-1 text-xs font-semibold ${badgeClasses}`}>
        {destination.subregion}
      </span>
    </div>

    <p class="text-sm text-stone-700">{destination.summary}</p>

    <dl class="grid grid-cols-2 gap-3 text-sm">
      <div>
        <dt class="font-semibold text-stone-900">Clima</dt>
        <dd class="text-stone-700">{destination.climate}</dd>
      </div>
      <div>
        <dt class="font-semibold text-stone-900">Dificultad</dt>
        <dd class="text-stone-700">{destination.difficulty}</dd>
      </div>
    </dl>

    <div>
      <h4 class="text-sm font-semibold text-stone-900">Actividades</h4>
      <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-stone-700">
        {shownActivities.map((activity) => <li>{activity}</li>)}
      </ul>
    </div>

    <details class="mt-auto rounded-lg border border-stone-200 bg-stone-50 p-3 text-sm">
      <summary class="cursor-pointer font-semibold text-emerald-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600">
        Ver más detalles
      </summary>
      <div class="mt-3 space-y-3 text-stone-700">
        <p><span class="font-semibold text-stone-900">Qué llevar:</span> {destination.extendedDetails.recommendedGear}</p>
        <p><span class="font-semibold text-stone-900">Mejor época:</span> {destination.extendedDetails.bestSeason}</p>
        <div>
          <p class="font-semibold text-stone-900">Para destacar:</p>
          <ul class="mt-1 list-disc space-y-1 pl-5">
            {destination.extendedDetails.localHighlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </details>
  </div>
</article>
