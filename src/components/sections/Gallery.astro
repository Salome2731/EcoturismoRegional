---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import galleryData from '../../data/gallery.json';
import type { GalleryItem } from '../../types';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/gallery/*.webp',
  { eager: true }
);

const filters = [
  { id: 'todos', label: 'Todos' },
  { id: 'naturaleza', label: 'Naturaleza' },
  { id: 'aventura', label: 'Aventura' },
  { id: 'cultural', label: 'Cultural' },
  { id: 'aguas', label: 'Aguas' },
];

const items = await Promise.all(
  (galleryData as GalleryItem[]).map(async (item) => {
    const key = `/src/assets/images/gallery/${item.image}`;
    const meta = images[key]?.default;
    if (!meta) throw new Error(`Imagen no encontrada para ${item.id}: ${key}`);
    const large = await getImage({ src: meta, width: 1600, format: 'webp' });
    return { item, meta, largeSrc: large.src };
  })
);
---

<section id="galeria" class="scroll-mt-20 bg-stone-50 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      title="Galería de paisajes"
      subtitle="Naturaleza, aventura, cultura y agua. Filtra por lo que más te llame y mira cada foto en grande."
    />

    <div role="group" aria-label="Filtrar galería por categoría" id="gallery-filters" class="mt-10 flex flex-wrap justify-center gap-3">
      {filters.map((f) => (
        <button
          type="button"
          data-filter={f.id}
          aria-pressed={f.id === 'todos' ? 'true' : 'false'}
          class="rounded-full border border-stone-400 bg-white px-5 py-2 text-sm font-semibold text-stone-900 transition hover:bg-stone-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-600 aria-pressed:border-emerald-800 aria-pressed:bg-emerald-800 aria-pressed:text-white"
        >
          {f.label}
        </button>
      ))}
    </div>

    <p id="gallery-status" role="status" aria-live="polite" class="sr-only"></p>

    <div id="gallery-grid" class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {items.map(({ item, meta, largeSrc }) => (
        <button
          type="button"
          class="gallery-item group overflow-hidden rounded-xl border border-stone-200 bg-white text-left shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-600"
          data-category={item.category}
          data-src={largeSrc}
          data-alt={item.alt}
          data-title={item.title}
          data-description={item.description}
          data-location={item.location}
        >
          <Image
            src={meta}
            alt={item.alt}
            width={640}
            height={360}
            loading="lazy"
            class="aspect-video w-full object-cover transition group-hover:scale-105"
          />
          <span class="block p-3">
            <span class="block text-sm font-bold text-stone-900">{item.title}</span>
            <span class="block text-xs text-stone-700">{item.location} · {item.category}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBar = document.getElementById('gallery-filters')!;
  const grid = document.getElementById('gallery-grid')!;
  const status = document.getElementById('gallery-status')!;
  const cards = grid.querySelectorAll<HTMLButtonElement>('.gallery-item');

  filterBar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!btn) return;
    const filter = btn.dataset.filter!;
    filterBar.querySelectorAll('button').forEach((b) =>
      b.setAttribute('aria-pressed', String(b === btn))
    );
    let shown = 0;
    cards.forEach((c) => {
      const match = filter === 'todos' || c.dataset.category === filter;
      c.classList.toggle('hidden', !match);
      if (match) shown++;
    });
    status.textContent = `Mostrando ${shown} fotos de la categoría ${btn.textContent?.trim()}`;
  });

  cards.forEach((c) =>
    c.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('gallery:open', {
          detail: {
            opener: c,
            src: c.dataset.src,
            alt: c.dataset.alt,
            title: c.dataset.title,
            description: c.dataset.description,
            location: c.dataset.location,
            category: c.dataset.category,
          },
        })
      );
    })
  );
</script>