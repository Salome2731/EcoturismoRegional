---
---

<dialog
  id="gallery-dialog"
  aria-labelledby="gallery-dialog-title"
  class="m-auto w-[calc(100%-2rem)] max-w-4xl rounded-xl bg-white p-0 shadow-2xl backdrop:bg-black/80"
>
  <div class="relative p-4 sm:p-6">
    <button
      type="button"
      id="gallery-dialog-close"
      aria-label="Cerrar visor"
      class="absolute right-3 top-3 z-10 rounded-full bg-stone-900 px-3 py-1 text-sm font-semibold text-white hover:bg-stone-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-amber-300"
    >
      ✕ Cerrar
    </button>
    <img
      id="gallery-dialog-img"
      src=""
      alt=""
      class="mx-auto max-h-[70vh] w-full rounded-lg object-contain"
    />
    <div class="mt-4">
      <h3 id="gallery-dialog-title" class="text-xl font-bold text-stone-900"></h3>
      <p id="gallery-dialog-meta" class="mt-1 text-sm font-medium text-emerald-800"></p>
      <p id="gallery-dialog-desc" class="mt-2 text-sm text-stone-700"></p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement;
  const img = document.getElementById('gallery-dialog-img') as HTMLImageElement;
  const title = document.getElementById('gallery-dialog-title')!;
  const meta = document.getElementById('gallery-dialog-meta')!;
  const desc = document.getElementById('gallery-dialog-desc')!;
  const closeBtn = document.getElementById('gallery-dialog-close')!;
  let opener: HTMLElement | null = null;

  // Gallery.astro dispara: window.dispatchEvent(new CustomEvent('gallery:open', { detail }))
  window.addEventListener('gallery:open', (e) => {
    const d = (e as CustomEvent).detail;
    opener = d.opener as HTMLElement;
    img.src = d.src;
    img.alt = d.alt;
    title.textContent = d.title;
    meta.textContent = `${d.location} · ${d.category}`;
    desc.textContent = d.description;
    dialog.showModal();
  });

  closeBtn.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => opener?.focus());
</script>
