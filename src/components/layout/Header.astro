---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const navLinks = [
  { href: '#destinos', label: 'Destinos' },
  { href: '#galeria', label: 'Galería' },
  { href: '#rutas', label: 'Rutas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class:list={["fixed top-0 left-0 right-0 z-50 bg-stone-900/90 backdrop-blur-md border-b border-stone-800 text-stone-100 transition-colors duration-200", className]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo / Marca -->
      <a
        href="#"
        class="flex items-center gap-2 text-emerald-400 hover:text-emerald-300 font-bold text-lg sm:text-xl tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-sm"
      >
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-950 border border-emerald-700/60 text-emerald-400 text-sm">
          🌿
        </span>
        <span>Ecoturismo Antioquia</span>
      </a>

      <!-- Navegación de escritorio (CA-NAV-01) -->
      <nav aria-label="Navegación principal" class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-stone-200 hover:text-emerald-400 hover:bg-stone-800/60 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Botón de menú móvil -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-stone-300 hover:text-emerald-400 hover:bg-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 transition-colors"
      >
        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-stone-800 bg-stone-900/98 px-4 pt-2 pb-6 space-y-2">
    <nav aria-label="Navegación móvil" class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link block px-3 py-2 text-base font-medium text-stone-200 hover:text-emerald-400 hover:bg-stone-800 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function closeMenu() {
    if (!mobileMenu || !menuBtn) return;
    mobileMenu.classList.add('hidden');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Abrir menú de navegación');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  function openMenu() {
    if (!mobileMenu || !menuBtn) return;
    mobileMenu.classList.remove('hidden');
    menuBtn.setAttribute('aria-expanded', 'true');
    menuBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
  }

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      menuBtn.focus();
    }
  });
</script>
